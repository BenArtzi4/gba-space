# Environment variable NAMES used by GBA spaces — values are NEVER committed.
# The repo is linked to Vercel: run `vercel env pull .env.local` to sync real
# values down for local dev (.env.local is gitignored), and `vercel env add
# <NAME> production` to set a secret. Only spaces that use a backend need these.

# --- Supabase (any space with a database; server-only, service role) ---------
# Used by app/<slug>/_lib/supabase.ts (see docs/SPACE-CONVENTIONS.md).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Owner overview (/all) ---------------------------------------------------
# Passcode for the gated "all routes" command center at /all.
SPACES_CODE=

# --- Per-space passcode gates ------------------------------------------------
# Convention: one var per gated space, named <SLUG_UPPER>_CODE.
# Example for the chase-medicine space:
CHASE_CODE=
# Add a new line per gated space you create, e.g.:
# MY_SPACE_CODE=

# --- App Arena (/app-arena) --------------------------------------------------
# Shared password for the three players (name picked in-app), and a random
# secret used to sign the identity cookie. Set both in Vercel for production.
APP_ARENA_PASSWORD=
APP_ARENA_SECRET=
